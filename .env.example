# Shared Cloudflare Stream library. Keep the API token server-side and secret.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=
CLOUDFLARE_STREAM_ALLOWED_ORIGINS=vivadspark.netlify.app,keen-starlight-a13c9a.netlify.app,hoshin-kanri-workspace.vivad-gpt-0611.chatgpt.site
LOTUS_AUTH_SERVICE_URL=https://script.google.com/macros/s/AKfycbxFTRc0Q3Kd-51nmYaM96fzzWHBbKaFoXujgQ7I7c-yHWy5teZu1j9SjA1IWjluuxc/exec
LOTUS_AUTH_SECRET=
# Optional comma-separated Lotus usernames permitted to delete Stream videos.
# Leave blank to retain the existing permission: any authenticated Lotus user.
TRAINING_VIDEO_DELETE_USERS=

# Netlify Database provisions this automatically for deploys and previews.
NETLIFY_DB_URL=

# Optional build-time/manual playback fallback. These are public playback identifiers.
NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER_CODE=
NEXT_PUBLIC_STREAM_VIDEO_NCE_FOUNDATIONS=
NEXT_PUBLIC_STREAM_VIDEO_ROOT_CAUSE=
NEXT_PUBLIC_STREAM_VIDEO_REMEDIAL_ACTION=
NEXT_PUBLIC_STREAM_VIDEO_DAILY_FLOW=
NEXT_PUBLIC_STREAM_VIDEO_HOSHIN_REVIEW=
NEXT_PUBLIC_STREAM_VIDEO_STANDARD_WORK=
